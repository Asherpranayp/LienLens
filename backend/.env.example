# Copy to .env and `export` these, or set them in your shell.
# With no API key, LienLens uses the offline rules extractor.
ANTHROPIC_API_KEY=
LIENLENS_EXTRACTOR=auto          # auto | llm | rules
LIENLENS_LLM_MODEL=claude-sonnet-4-5
LIENLENS_LOW_CONFIDENCE=0.75     # fields below this confidence are flagged for review

# Optional PostgreSQL (SQLite is used when POSTGRES_DB is unset)
# POSTGRES_DB=lienlens
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
